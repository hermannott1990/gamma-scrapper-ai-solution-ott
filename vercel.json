{
  "version": 2,
  "rewrites": [
    {
      "source": "/",
      "destination": "/out/index.html"
    },
    {
      "source": "/assets/:path*",
      "destination": "/out/assets/:path*"
    },
    {
      "source": "/contact.php",
      "destination": "/api/contact"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "POST, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type"
        }
      ]
    }
  ]
}
